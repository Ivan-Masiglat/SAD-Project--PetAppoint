rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'admin@gmail.com';
    }

    match /clients/{clientId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == clientId);
      allow create: if request.auth != null
        && request.auth.uid == clientId
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email', 'phone', 'createdAt'])
        && request.resource.data.keys().hasAll(['firstName', 'lastName', 'email', 'phone', 'createdAt'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'minutes', 'description', 'price', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'minutes', 'description', 'price', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.minutes is int
        && request.resource.data.minutes > 0
        && request.resource.data.minutes <= 1440
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 500
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 1000000
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['price'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 1000000;
      allow delete: if false;
    }

    match /servicePrices/{serviceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['price', 'updatedAt'])
        && request.resource.data.keys().hasAll(['price', 'updatedAt'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 1000000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.token.email != 'admin@gmail.com'
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ref', 'email', 'petId', 'petName', 'petSpecies',
          'service', 'services', 'minutes', 'date', 'time', 'slotId', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerUid', 'ref', 'email', 'petId', 'petName', 'petSpecies',
          'service', 'services', 'minutes', 'date', 'time', 'slotId', 'status', 'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.ref is string
        && request.resource.data.petId is string
        && request.resource.data.petName is string
        && request.resource.data.petSpecies is string
        && request.resource.data['service'] is string
        && request.resource.data.services is list
        && request.resource.data.minutes is int
        && request.resource.data.minutes > 0
        && request.resource.data.minutes <= 1440
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.slotId is string
        && getAfter(/databases/$(database)/documents/appointmentSlots/$(request.resource.data.slotId)).data.appointmentId == appointmentId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if (
        request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'petName', 'petSpecies'
        ])
        && request.resource.data.petName is string
        && request.resource.data.petName.size() > 0
        && request.resource.data.petName.size() <= 80
        && request.resource.data.petSpecies is string
        && request.resource.data.petSpecies.size() > 0
        && request.resource.data.petSpecies.size() <= 80
      ) || (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'previousStatus', 'date', 'time', 'slotId'
        ])
        && (
          (
            resource.data.status in ['pending', 'confirmed']
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slotId'])
            && request.resource.data.slotId is string
            && getAfter(/databases/$(database)/documents/appointmentSlots/$(request.resource.data.slotId)).data.appointmentId == appointmentId
            && getAfter(/databases/$(database)/documents/appointmentSlots/$(request.resource.data.slotId)).data.date == resource.data.date
            && getAfter(/databases/$(database)/documents/appointmentSlots/$(request.resource.data.slotId)).data.time == resource.data.time
          )
          || (
            (resource.data.status == 'pending'
              && request.resource.data.status in ['confirmed', 'cancelled'])
            || (resource.data.status == 'confirmed'
              && request.resource.data.status in ['completed', 'cancelled'])
            || (resource.data.status == 'cancelled'
              && request.resource.data.status in ['pending', 'confirmed']
              && request.resource.data.date is string
              && request.resource.data.time is string)
          )
        )
        && (request.resource.data.status != 'cancelled'
          || request.resource.data.previousStatus == resource.data.status)
      );
      allow delete: if false;
    }

    match /appointmentSlots/{slotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['appointmentId', 'date', 'time'])
        && request.resource.data.keys().hasAll(['appointmentId', 'date', 'time'])
        && request.resource.data.appointmentId is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.slotId == slotId
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.time == request.resource.data.time
        && (isAdmin()
          || getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.ownerUid == request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /appointmentAvailability/{slotId} {
      function matchesReservedAppointment() {
        let reservation = getAfter(/databases/$(database)/documents/appointmentSlots/$(slotId)).data;
        let appointment = getAfter(/databases/$(database)/documents/appointments/$(reservation.appointmentId)).data;
        return reservation.date == request.resource.data.date
          && reservation.time == request.resource.data.time
          && reservation.appointmentId is string
          && appointment.slotId == slotId
          && appointment.date == request.resource.data.date
          && appointment.time == request.resource.data.time
          && (isAdmin() || appointment.ownerUid == request.auth.uid);
      }

      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['date', 'time'])
        && request.resource.data.keys().hasAll(['date', 'time'])
        && request.resource.data.date is string
        && request.resource.data.time is string
        && matchesReservedAppointment();
      allow delete: if isAdmin();
    }
  }
}
